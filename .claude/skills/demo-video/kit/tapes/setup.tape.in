Set Shell "bash"
Set FontFamily "Menlo, Sukhumvit Set"
Set FontSize 24
Set Width 1440
Set Height 900
Set Padding 36
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Hide
Type "export PATH=@WORK@/bin:$PATH BASH_SILENCE_DEPRECATION_WARNING=1 PS1='\[\e[1;36m\]\W\[\e[0m\] \$ ' && cd @WORK@/shop && export GIT_PAGER=cat && clear"
Enter
Sleep 500ms
Show
