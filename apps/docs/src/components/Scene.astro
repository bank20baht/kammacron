---
/**
 * One step of a <Walkthrough>: its words (the slot) and what the screen showed then, in a window:
 * one screenshot, two side by side (`images`), or a terminal (`terminal`, lines starting `$ ` are
 * typed). Without the walkthrough's script, or on a narrow screen, the window sits under the words.
 */
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  /** What the window's bar says: a URL, or the terminal's folder. */
  bar?: string
  image?: ImageMetadata
  /** Two screens at once, left and right. */
  images?: ImageMetadata[]
  alt?: string
  terminal?: string
}

const { title, bar, image, images, alt = '', terminal } = Astro.props
const shots = images ?? (image ? [image] : [])
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
// typed lines in the terminal's own colour, the output dimmer; set:html keeps <pre>'s whitespace exact
const html = (terminal ?? '')
  .replace(/^\n+|\s+$/g, '')
  .split('\n')
  .map((line) =>
    line.startsWith('$ ')
      ? `<span class="typed"><span class="prompt">$ </span>${escape(line.slice(2))}</span>`
      : `<span class="out">${escape(line)}</span>`,
  )
  .join('\n')
---

<section class="scene" data-scene>
  <div class="scene-text">
    <h3 class="scene-title"><span class="scene-n" aria-hidden="true"></span>{title}</h3>
    <slot />
  </div>
  <figure class="scene-media not-content" data-media>
    {
      terminal !== undefined ? (
        <div class="window terminal">
          <div class="bar">
            <span class="dots" aria-hidden="true" />
            <span class="where">{bar ?? 'zsh'}</span>
          </div>
          <pre aria-label={alt || title} set:html={html} />
        </div>
      ) : (
        <div class:list={['shots', { pair: shots.length > 1 }]}>
          {shots.map((src, i) => (
            <div class="window">
              <div class="bar">
                <span class="dots" aria-hidden="true" />
                <span class="where">{(bar ?? '').split(' | ')[i] ?? ''}</span>
              </div>
              <Image src={src} alt={shots.length > 1 ? `${alt} (${String(i + 1)} of ${String(shots.length)})` : alt} widths={[720, 1440]} sizes="(min-width: 72rem) 46rem, 100vw" />
            </div>
          ))}
        </div>
      )
    }
  </figure>
</section>
