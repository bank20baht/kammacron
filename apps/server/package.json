{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "dist/types/index.d.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@20baht/elysia-idempotency": "^0.1.2",
    "@20baht/elysia-openapi-mcp": "^0.2.1",
    "@20baht/live": "^0.1.1",
    "@electric-sql/pglite": "^0.6.0",
    "@elysiajs/openapi": "^1.4.17",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.31"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
