---
/**
 * The landing page's four steps, each with a sticker that pops in once, a little after the one
 * before it (a first visit's delight; it rests after that, and replays when hovered).
 */
const steps = [
  {
    sticker: 'notebook',
    title: 'Write a card',
    text: 'On the board, or from Claude Code over MCP. Tag it `claude`, or `playbook:deploy`.',
  },
  {
    sticker: 'ai-agent',
    title: 'Claude works it',
    text: 'On the project’s interval, in its directory, with a tool allowlist instead of skipped permissions.',
  },
  {
    sticker: 'terminal',
    title: 'Your steps run',
    text: 'Tests, ssh, a deploy, a migration: the playbook’s commands, in order. One fails, the rest stop.',
  },
  {
    sticker: 'verified',
    title: 'You decide',
    text: 'What needs a person waits in Review with its reason and output. Approve, send back, or take it.',
  },
]
// pop-ins a beat apart, quick at first and settling (not a metronome)
const enter = [0.15, 0.27, 0.36, 0.43]
const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>')
---

<ol class="how" aria-label="How kammacron works">
  {
    steps.map((step, i) => (
      <li class="step">
        <baht-sticker
          name={step.sticker}
          once
          replay-on-hover
          enter={enter[i]}
          offset={i * 7}
          label={step.title}
        />
        <span class="n" aria-hidden="true">
          {i + 1}
        </span>
        <h3>{step.title}</h3>
        <p set:html={code(step.text)} />
      </li>
    ))
  }
</ol>

<script>
  import '@20baht/stickers/element'
  import { registerSticker } from '@20baht/stickers'
  import { aiAgent } from '@20baht/stickers/icons/ai-agent'
  import { notebook } from '@20baht/stickers/icons/notebook'
  import { terminal } from '@20baht/stickers/icons/terminal'
  import { verified } from '@20baht/stickers/icons/verified'

  for (const icon of [notebook, aiAgent, terminal, verified]) registerSticker(icon)
</script>

<style>
  .how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 1rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
  }
  /* a dashed path from one step to the next, on wide screens where they sit in a row */
  @media (min-width: 72rem) {
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 3.5rem;
      left: calc(7.5rem + 0.5rem);
      right: -1rem;
      border-top: 2px dashed var(--sl-color-gray-5);
    }
  }
  baht-sticker {
    width: 7.5rem;
    margin-inline-start: -0.5rem;
  }
  .n {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent);
  }
  .step h3 {
    margin: 0;
    font-size: var(--sl-text-lg);
  }
  .step p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-wrap: pretty;
  }
  /* on a phone, one step per row: the sticker smaller, beside its words */
  @media (max-width: 40rem) {
    .how {
      gap: 1.25rem;
    }
    .step {
      display: grid;
      grid-template-columns: 4.5rem 1fr;
      column-gap: 0.75rem;
      row-gap: 0.2rem;
      align-items: start;
    }
    baht-sticker {
      grid-row: 1 / span 3;
      width: 4.5rem;
      margin: 0;
    }
  }
</style>
