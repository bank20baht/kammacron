{
  "name": "kammacron-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "What the host and its remotes share: the typed API client and error text. Imported as @kammacron/kit through a tsconfig path, so each app compiles its own copy.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretypecheck": "bun run --filter server build:types",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@angular/core": "^22.2.0",
    "@20baht/ngx-eden": "^0.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "server": "workspace:*",
    "typescript": "~6.0.2"
  }
}
